<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>2friend</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, sans-serif;
      background: #121212;
      color: #ffffff;
      padding-bottom: 76px;
    }
    header {
      position: sticky;
      top: 0;
      background: #181818;
      padding: 12px 16px;
      border-bottom: 1px solid #2a2a2a;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
    }
    .logo {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .stories {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding: 12px 16px;
      border-bottom: 1px solid #242424;
    }
    .story {
      min-width: 66px;
      text-align: center;
      font-size: 12px;
      color: #ccc;
    }
    .avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #2c2c2c;
      border: 2px solid #4caf50;
      margin: 0 auto 6px;
    }
    .tab-section {
      display: none;
      padding: 14px 16px;
      flex-direction: column;
      gap: 14px;
    }
    .tab-section.active {
      display: flex;
    }
    .card {
      background: #1c1c1c;
      border: 1px solid #2b2b2b;
      border-radius: 12px;
      padding: 14px;
    }
    .card-header {
      font-weight: 600;
      margin-bottom: 8px;
    }
    .media-box {
      height: 220px;
      background: #262626;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #aaa;
      margin: 8px 0 10px;
    }
    .actions {
      display: flex;
      gap: 16px;
      font-size: 14px;
      color: #bbb;
      align-items: center;
    }
    .like-btn {
      background: none;
      border: none;
      color: #bbb;
      font-size: 14px;
      padding: 4px 0;
      cursor: pointer;
    }
    .like-btn.liked {
      color: #ff5252;
      font-weight: 600;
    }
    textarea, input {
      width: 100%;
      background: #262626;
      border: 1px solid #3a3a3a;
      color: #fff;
      border-radius: 8px;
      padding: 10px;
      margin-top: 8px;
      font-family: inherit;
    }
    .primary-btn {
      margin-top: 10px;
      background: #4caf50;
      color: #fff;
      border: none;
      padding: 10px 14px;
      border-radius: 8px;
      font-weight: 600;
      width: 100%;
      cursor: pointer;
    }
    nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #181818;
      border-top: 1px solid #2a2a2a;
      display: flex;
      justify-content: space-around;
      padding: 10px 0;
      z-index: 10;
    }
    nav button {
      background: none;
      border: none;
      color: #888;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }
    nav button.active {
      color: #4caf50;
    }
  </style>
</head>
<body>
  <header>
    <span class="logo">2friend</span>
    <span style="font-size:12px; color:#aaa;">हिंदी</span>
  </header>

  <section class="stories">
    <div class="story"><div class="avatar"></div>आपकी स्टोरी</div>
    <div class="story"><div class="avatar"></div>दोस्त 1</div>
    <div class="story"><div class="avatar"></div>दोस्त 2</div>
    <div class="story"><div class="avatar"></div>दोस्त 3</div>
  </section>

  <!-- Feed Tab -->
  <main id="tab-feed" class="tab-section active">
    <article class="card" data-post-id="official">
      <div class="card-header">2friend Official</div>
      <div class="media-box">Short Video / Story Preview</div>
      <div class="actions">
        <button class="like-btn" onclick="toggleLike('official', this)">Like (0)</button>
        <span>Comment</span>
        <span>Share</span>
      </div>
    </article>
  </main>

  <!-- Stories Tab -->
  <section id="tab-stories" class="tab-section">
    <div class="card">
      <div class="card-header">सभी स्टोरीज़</div>
      <p style="color:#bbb; font-size:14px;">यहाँ दोस्तों की स्टोरी और शॉर्ट वीडियो दिखेंगे।</p>
    </div>
  </section>

  <!-- Create Tab -->
  <section id="tab-create" class="tab-section">
    <div class="card">
      <div class="card-header">नई पोस्ट बनाएं</div>
      <textarea id="postInput" rows="3" placeholder="अपने दोस्तों के साथ कुछ शेयर करें..."></textarea>
      <button class="primary-btn" onclick="addPost()">पोस्ट करें</button>
    </div>
  </section>

  <!-- Profile Tab -->
  <section id="tab-profile" class="tab-section">
    <div class="card">
      <div class="card-header">मेरी प्रोफ़ाइल</div>
      <p style="color:#bbb; font-size:14px;">यूज़रनेम: @2friend_user</p>
      <p id="postCount" style="color:#bbb; font-size:14px;">पोस्ट: 1 · फ़ॉलोअर्स: 0</p>
    </div>
  </section>

  <nav>
    <button class="active" onclick="switchTab('feed', this)">Feed</button>
    <button onclick="switchTab('stories', this)">Stories</button>
    <button onclick="switchTab('create', this)">Create</button>
    <button onclick="switchTab('profile', this)">Profile</button>
  </nav>

  <script>
    const POSTS_KEY = '2friend_posts';
    const LIKES_KEY = '2friend_likes';

    function getSavedPosts() {
      try {
        return JSON.parse(localStorage.getItem(POSTS_KEY)) || [];
      } catch {
        return [];
      }
    }

    function savePosts(posts) {
      localStorage.setItem(POSTS_KEY, JSON.stringify(posts));
    }

    function getLikes() {
      try {
        return JSON.parse(localStorage.getItem(LIKES_KEY)) || {};
      } catch {
        return {};
      }
    }

    function saveLikes(likes) {
      localStorage.setItem(LIKES_KEY, JSON.stringify(likes));
    }

    function updateLikeUI(btn, likeData) {
      const count = likeData.count || 0;
      const liked = Boolean(likeData.liked);
      btn.textContent = `Like (${count})`;
      btn.classList.toggle('liked', liked);
    }

    function toggleLike(postId, btn) {
      const likes = getLikes();
      const current = likes[postId] || { count: 0, liked: false };
      if (current.liked) {
        current.count = Math.max(0, current.count - 1);
        current.liked = false;
      } else {
        current.count += 1;
        current.liked = true;
      }
      likes[postId] = current;
      saveLikes(likes);
      updateLikeUI(btn, current);
    }

    function renderPosts() {
      const feed = document.getElementById('tab-feed');
      feed.querySelectorAll('.user-post').forEach(el => el.remove());

      const likes = getLikes();
      const officialBtn = feed.querySelector('[data-post-id="official"] .like-btn');
      if (officialBtn) {
        updateLikeUI(officialBtn, likes['official'] || { count: 0, liked: false });
      }

      const posts = getSavedPosts();
      posts.forEach((post, index) => {
        const postId = post.id || ('user_' + index);
        const text = typeof post === 'string' ? post : post.text;
        const card = document.createElement('article');
        card.className = 'card user-post';
        card.dataset.postId = postId;
        card.innerHTML = `
          <div class="card-header">@2friend_user</div>
          <p style="margin:6px 0 10px; color:#eee;">${text}</p>
          <div class="actions">
            <button class="like-btn" onclick="toggleLike('${postId}', this)">Like (0)</button>
            <span>Comment</span>
            <span>Share</span>
          </div>
        `;
        feed.prepend(card);
        const btn = card.querySelector('.like-btn');
        updateLikeUI(btn, likes[postId] || { count: 0, liked: false });
      });

      document.getElementById('postCount').textContent = `पोस्ट: ${1 + posts.length} · फ़ॉलोअर्स: 0`;
    }

    function switchTab(tabName, btn) {
      document.querySelectorAll('.tab-section').forEach(sec => sec.classList.remove('active'));
      document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
      const target = document.getElementById('tab-' + tabName);
      if (target) target.classList.add('active');
      if (btn) btn.classList.add('active');
    }

    function addPost() {
      const input = document.getElementById('postInput');
      const text = input.value.trim();
      if (!text) return;

      const posts = getSavedPosts();
      posts.push({ id: 'post_' + Date.now(), text });
      savePosts(posts);
      renderPosts();

      input.value = '';
      switchTab('feed', document.querySelector('nav button'));
    }

    renderPosts();
  </script>
</body>
</html>
