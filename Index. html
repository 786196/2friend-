<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>2friend</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, sans-serif;
      background: #121212;
      color: #ffffff;
      padding-bottom: 76px;
    }
    header {
      position: sticky;
      top: 0;
      background: #181818;
      padding: 12px 16px;
      border-bottom: 1px solid #2a2a2a;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
    }
    .logo {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .stories {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding: 12px 16px;
      border-bottom: 1px solid #242424;
    }
    .story {
      min-width: 66px;
      text-align: center;
      font-size: 12px;
      color: #ccc;
    }
    .avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #2c2c2c;
      border: 2px solid #4caf50;
      margin: 0 auto 6px;
    }
    .tab-section {
      display: none;
      padding: 14px 16px;
      flex-direction: column;
      gap: 14px;
    }
    .tab-section.active {
      display: flex;
    }
    .card {
      background: #1c1c1c;
      border: 1px solid #2b2b2b;
      border-radius: 12px;
      padding: 14px;
    }
    .card-header {
      font-weight: 600;
      margin-bottom: 8px;
    }
    .media-box {
      height: 220px;
      background: #262626;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #aaa;
      margin: 8px 0 10px;
    }
    .actions {
      display: flex;
      gap: 16px;
      font-size: 14px;
      color: #bbb;
      align-items: center;
    }
    .action-btn {
      background: none;
      border: none;
      color: #bbb;
      font-size: 14px;
      padding: 4px 0;
      cursor: pointer;
    }
    .action-btn.liked {
      color: #ff5252;
      font-weight: 600;
    }
    .comment-box {
      display: none;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #2a2a2a;
    }
    .comment-box.open {
      display: block;
    }
    .comment-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 8px;
      font-size: 13px;
      color: #ddd;
    }
    .comment-item {
      background: #242424;
      padding: 6px 10px;
      border-radius: 6px;
    }
    .comment-row {
      display: flex;
      gap: 8px;
    }
    .comment-row input {
      margin-top: 0;
      flex: 1;
    }
    .comment-row button {
      background: #4caf50;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 0 12px;
      font-weight: 600;
      cursor: pointer;
    }
    textarea, input {
      width: 100%;
      background: #262626;
      border: 1px solid #3a3a3a;
      color: #fff;
      border-radius: 8px;
      padding: 10px;
      margin-top: 8px;
      font-family: inherit;
    }
    .primary-btn {
      margin-top: 10px;
      background: #4caf50;
      color: #fff;
      border: none;
      padding: 10px 14px;
      border-radius: 8px;
      font-weight: 600;
      width: 100%;
      cursor: pointer;
    }
    nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #181818;
      border-top: 1px solid #2a2a2a;
      display: flex;
      justify-content: space-around;
      padding: 10px 0;
      z-index: 10;
    }
    nav button {
      background: none;
      border: none;
      color: #888;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }
    nav button.active {
      color: #4caf50;
    }
  </style>
</head>
<body>
  <header>
    <span class="logo">2friend</span>
    <span style="font-size:12px; color:#aaa;">हिंदी</span>
  </header>

  <section class="stories">
    <div class="story"><div class="avatar"></div>आपकी स्टोरी</div>
    <div class="story"><div class="avatar"></div>दोस्त 1</div>
    <div class="story"><div class="avatar"></div>दोस्त 2</div>
    <div class="story"><div class="avatar"></div>दोस्त 3</div>
  </section>

  <!-- Feed Tab -->
  <main id="tab-feed" class="tab-section active">
    <article class="card" data-post-id="official">
      <div class="card-header">2friend Official</div>
      <div class="media-box">Short Video / Story Preview</div>
      <div class="actions">
        <button class="action-btn like-btn" onclick="toggleLike('official', this)">Like (0)</button>
        <button class="action-btn comment-toggle" onclick="toggleCommentBox('official')">Comment (0)</button>
        <span>Share</span>
      </div>
      <div id="comments-official" class="comment-box">
        <div class="comment-list"></div>
        <div class="comment-row">
          <input type="text" placeholder="कमेंट लिखें..." onkeydown="if(event.key==='Enter') addComment('official', this)" />
          <button onclick="addComment('official', this.previousElementSibling)">भेजें</button>
        </div>
      </div>
    </article>
  </main>

  <!-- Stories Tab -->
  <section id="tab-stories" class="tab-section">
    <div class="card">
      <div class="card-header">सभी स्टोरीज़</div>
      <p style="color:#bbb; font-size:14px;">यहाँ दोस्तों की स्टोरी और शॉर्ट वीडियो दिखेंगे।</p>
    </div>
  </section>

  <!-- Create Tab -->
  <section id="tab-create" class="tab-section">
    <div class="card">
      <div class="card-header">नई पोस्ट बनाएं</div>
      <textarea id="postInput" rows="3" placeholder="अपने दोस्तों के साथ कुछ शेयर करें..."></textarea>
      <button class="primary-btn" onclick="addPost()">पोस्ट करें</button>
    </div>
  </section>

  <!-- Profile Tab -->
  <section id="tab-profile" class="tab-section">
    <div class="card">
      <div class="card-header">मेरी प्रोफ़ाइल</div>
      <p style="color:#bbb; font-size:14px;">यूज़रनेम: @2friend_user</p>
      <p id="postCount" style="color:#bbb; font-size:14px;">पोस्ट: 1 · फ़ॉलोअर्स: 0</p>
    </div>
  </section>

  <nav>
    <button class="active" onclick="switchTab('feed', this)">Feed</button>
    <button onclick="switchTab('stories', this)">Stories</button>
    <button onclick="switchTab('create', this)">Create</button>
    <button onclick="switchTab('profile', this)">Profile</button>
  </nav>

  <script>
    const POSTS_KEY = '2friend_posts';
    const LIKES_KEY = '2friend_likes';
    const COMMENTS_KEY = '2friend_comments';

    function readStorage(key, fallback) {
      try {
        return JSON.parse(localStorage.getItem(key)) ?? fallback;
      } catch {
        return fallback;
      }
    }

    function writeStorage(key, value) {
      localStorage.setItem(key, JSON.stringify(value));
    }

    function updateLikeUI(btn, likeData) {
      const count = likeData.count || 0;
      const liked = Boolean(likeData.liked);
      btn.textContent = `Like (${count})`;
      btn.classList.toggle('liked', liked);
    }

    function toggleLike(postId, btn) {
      const likes = readStorage(LIKES_KEY, {});
      const current = likes[postId] || { count: 0, liked: false };
      if (current.liked) {
        current.count = Math.max(0, current.count - 1);
        current.liked = false;
      } else {
        current.count += 1;
        current.liked = true;
      }
      likes[postId] = current;
      writeStorage(LIKES_KEY, likes);
      updateLikeUI(btn, current);
    }

    function toggleCommentBox(postId) {
      const box = document.getElementById('comments-' + postId);
      if (box) box.classList.toggle('open');
    }

    function renderCommentsForPost(postId) {
      const allComments = readStorage(COMMENTS_KEY, {});
      const list = allComments[postId] || [];
      const card = document.querySelector(`[data-post-id="${postId}"]`);
      if (!card) return;

      const toggleBtn = card.querySelector('.comment-toggle');
      if (toggleBtn) toggleBtn.textContent = `Comment (${list.length})`;

      const listEl = card.querySelector('.comment-list');
      if (listEl) {
        listEl.innerHTML = list.map(c => `<div class="comment-item">${c}</div>`).join('');
      }
    }

    function addComment(postId, inputEl) {
      const text = inputEl.value.trim();
      if (!text) return;

      const allComments = readStorage(COMMENTS_KEY, {});
      const list = allComments[postId] || [];
      list.push(text);
      allComments[postId] = list;
      writeStorage(COMMENTS_KEY, allComments);

      inputEl.value = '';
      renderCommentsForPost(postId);
    }

    function renderPosts() {
      const feed = document.getElementById('tab-feed');
      feed.querySelectorAll('.user-post').forEach(el => el.remove());

      const likes = readStorage(LIKES_KEY, {});
      const officialBtn = feed.querySelector('[data-post-id="official"] .like-btn');
      if (officialBtn) {
        updateLikeUI(officialBtn, likes['official'] || { count: 0, liked: false });
      }
      renderCommentsForPost('official');

      const posts = readStorage(POSTS_KEY, []);
      posts.forEach((post, index) => {
        const postId = post.id || ('user_' + index);
        const text = typeof post === 'string' ? post : post.text;
        const card = document.createElement('article');
        card.className = 'card user-post';
        card.dataset.postId = postId;
        card.innerHTML = `
          <div class="card-header">@2friend_user</div>
          <p style="margin:6px 0 10px; color:#eee;">${text}</p>
          <div class="actions">
            <button class="action-btn like-btn" onclick="toggleLike('${postId}', this)">Like (0)</button>
            <button class="action-btn comment-toggle" onclick="toggleCommentBox('${postId}')">Comment (0)</button>
            <span>Share</span>
          </div>
          <div id="comments-${postId}" class="comment-box">
            <div class="comment-list"></div>
            <div class="comment-row">
              <input type="text" placeholder="कमेंट लिखें..." onkeydown="if(event.key==='Enter') addComment('${postId}', this)" />
              <button onclick="addComment('${postId}', this.previousElementSibling)">भेजें</button>
            </div>
          </div>
        `;
        feed.prepend(card);
        const btn = card.querySelector('.like-btn');
        updateLikeUI(btn, likes[postId] || { count: 0, liked: false });
        renderCommentsForPost(postId);
      });

      document.getElementById('postCount').textContent = `पोस्ट: ${1 + posts.length} · फ़ॉलोअर्स: 0`;
    }

    function switchTab(tabName, btn) {
      document.querySelectorAll('.tab-section').forEach(sec => sec.classList.remove('active'));
      document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
      const target = document.getElementById('tab-' + tabName);
      if (target) target.classList.add('active');
      if (btn) btn.classList.add('active');
    }

    function addPost() {
      const input = document.getElementById('postInput');
      const text = input.value.trim();
      if (!text) return;

      const posts = readStorage(POSTS_KEY, []);
      posts.push({ id: 'post_' + Date.now(), text });
      writeStorage(POSTS_KEY, posts);
      renderPosts();

      input.value = '';
      switchTab('feed', document.querySelector('nav button'));
    }

    renderPosts();
  </script>
</body>
</html>
